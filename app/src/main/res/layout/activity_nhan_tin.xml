<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_bg">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/headerToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            app:tint="@color/figma_text_primary" />

        <TextView
            android:id="@+id/avatarHeader"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="12dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_logo_badge"
            android:gravity="center"
            android:text="PH"
            android:textColor="@color/figma_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/avatarHeader"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ThS. Đỗ Phú Huy"
                android:textColor="@color/figma_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Đang trực tuyến"
                android:textColor="@color/green_badge_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="Info"
            app:tint="@color/figma_blue" />
    </RelativeLayout>

    <!-- Chat Messages Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerToolbar"
        android:layout_above="@id/bottomInputBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Date Separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="12dp"
                android:text="Hôm nay, 26/09/2026"
                android:textColor="@color/figma_text_secondary"
                android:textSize="12sp" />

            <!-- Sent Bubble 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_blue_card"
                    android:padding="14dp"
                    android:text="Em chào thầy, em muốn trao đổi về bài tập và đề tài môn Lập trình di động ạ."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="09:30 · Đã xem"
                    android:textColor="@color/figma_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Received Bubble 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_chip"
                    android:padding="14dp"
                    android:text="Chào em, em cần thầy hỗ trợ phần nào của bài tập?"
                    android:textColor="@color/figma_text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="09:32"
                    android:textColor="@color/figma_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sent Bubble 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_blue_card"
                    android:padding="14dp"
                    android:text="Thầy cho em xin tài liệu tham khảo về xây dựng giao diện Android được không ạ?"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="09:34 · Đã xem"
                    android:textColor="@color/figma_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Received Bubble 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_chip"
                    android:padding="14dp"
                    android:text="Thầy sẽ gửi tài liệu..."
                    android:textColor="@color/figma_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="09:35"
                    android:textColor="@color/figma_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/bottomInputBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="Attachment"
            app:tint="@color/figma_text_secondary" />

        <EditText
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_tag_chip"
            android:hint="Nhập tin nhắn..."
            android:paddingHorizontal="16dp"
            android:textColorHint="@color/figma_text_secondary"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_blue_card">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Send"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
